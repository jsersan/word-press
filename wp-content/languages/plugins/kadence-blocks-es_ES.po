msgstr "El CSS combinado del editor de tokens de diseño para cada biblioteca de tokens."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2473
msgid "The preset slugs in their new display order."
msgstr "Los slugs de ajustes predefinidos en su nuevo orden de visualización."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2429
msgid "Optional default preset slug."
msgstr "Slug de ajuste predefinido predeterminado opcional."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2423
msgid "The presets to store, keyed by slug."
msgstr "Los ajustes predefinidos que almacenar, indexados por slug."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2401
msgid "The preset's property => alias-or-literal token map."
msgstr "El mapa de tokens propiedad => alias o literal del ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2395
msgid "Optional human-readable label for the preset."
msgstr "Etiqueta legible por personas opcional para el ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2388
msgid "The preset slug to create or merge."
msgstr "El slug del ajuste predefinido que crear o fusionar."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2365
msgid "The preset slug."
msgstr "El slug del ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2325
msgid "The block name segment, e.g. singlebtn."
msgstr "El segmento del nombre del bloque, por ejemplo, singlebtn."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2318
msgid "The block vendor segment, e.g. kadence."
msgstr "El segmento del proveedor del bloque, por ejemplo, kadence."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1864
msgid "A preset alias does not resolve to a token."
msgstr "Un alias de ajuste predefinido no se resuelve en un token."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1768
msgid "A preset can only set properties the block binds."
msgstr "Un ajuste predefinido solo puede establecer propiedades que el bloque vincule."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1719
msgid "A theme preset cannot be the default preset."
msgstr "Un ajuste predefinido del tema no puede ser el ajuste predefinido predeterminado."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1691
msgid "The default preset must name an existing preset."
msgstr "El ajuste predefinido predeterminado debe indicar un ajuste predefinido existente."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1655
msgid "A shadow value must be an alias, a literal, or a composite carrying color, offsetX, offsetY, blur and spread."
msgstr "Un valor de sombra debe ser un alias, un literal o un compuesto que incluya color, offsetX, offsetY, desenfoque y propagación."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1611
msgid "A per-corner responsive override requires a per-corner base value for the same property."
msgstr "Una anulación adaptable por esquina requiere un valor base por esquina para la misma propiedad."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1598
msgid "A dimension value must not contain a space; compound literals (e.g. calc(), clamp()) are not supported."
msgstr "Un valor de dimensión no debe contener un espacio; no se admiten literales compuestos (por ejemplo, calc(), clamp())."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1550
msgid "A per-corner base value must set every corner; a gap is only valid inside a responsive override."
msgstr "Un valor base por esquina debe establecer todas las esquinas; un hueco solo es válido dentro de una anulación adaptable."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1509
msgid "A per-corner value is only valid for a dimension property."
msgstr "Un valor por esquina solo es válido para una propiedad de dimensión."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1379
msgid "That preset slug is reserved."
msgstr "Ese slug de ajuste predefinido está reservado."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1305
msgid "A preset cannot set theme-owned keys."
msgstr "Un ajuste predefinido no puede establecer claves propiedad del tema."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1266
msgid "Each preset must be an object with an optional string label and a token map."
msgstr "Cada ajuste predefinido debe ser un objeto con una etiqueta de cadena opcional y un mapa de tokens."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1248
msgid "A preset slug cannot be empty."
msgstr "Un slug de ajuste predefinido no puede estar vacío."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1189
msgid "Sorry, that block does not accept presets."
msgstr "Lo siento, ese bloque no acepta ajustes predefinidos."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1133
msgid "The design token library could not be encoded."
msgstr "No se pudo codificar la biblioteca de tokens de diseño."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1048
msgid "The theme values the preset had when its overrides were last saved."
msgstr "Los valores del tema que tenía el ajuste predefinido cuando se guardaron por última vez sus anulaciones."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1043
msgid "The overrides the preset keeps."
msgstr "Las anulaciones que conserva el ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1039
msgid "The label the preset was stored with."
msgstr "La etiqueta con la que se almacenó el ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1031
msgid "The stored theme presets the active theme does not offer, keyed by slug: not listed, not projected, kept until a theme that offers them is active again."
msgstr "Los ajustes predefinidos del tema almacenados que el tema activo no ofrece, indexados por slug: no se listan, no se proyectan y se conservan hasta que vuelva a estar activo un tema que los ofrezca."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1025
msgid "The named presets, keyed by slug."
msgstr "Los ajustes predefinidos con nombre, indexados por slug."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1018
msgid "The preset slugs the library defines beyond the baseline. Deleting one removes it; deleting anything else at most reverts an override."
msgstr "Los slugs de ajustes predefinidos que define la biblioteca más allá de la base. Borrar uno lo elimina; borrar cualquier otra cosa como mucho revierte una anulación."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:1013
#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2450
msgid "The default preset slug."
msgstr "El slug del ajuste predefinido predeterminado."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:995
msgid "The block name the preset collection belongs to."
msgstr "El nombre del bloque al que pertenece la colección de ajustes predefinidos."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:982
msgid "Whether the theme's values behind this preset could be read. A preset that is not readable can be previewed and picked but offers nothing to edit."
msgstr "Indica si se pudieron leer los valores del tema que hay detrás de este ajuste predefinido. Un ajuste predefinido que no es legible se puede previsualizar y elegir, pero no ofrece nada que editar."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:976
msgid "The values the theme currently renders for this preset, for display only: a control shows them as muted defaults and a save stores only the values that differ."
msgstr "Los valores que el tema renderiza actualmente para este ajuste predefinido, solo para mostrarlos: un control los muestra como valores predeterminados atenuados y un guardado solo almacena los valores que difieren."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:971
msgid "The classes the theme's own stylesheet paints this preset through, for a preset painted by class rather than by variables."
msgstr "Las clases con las que la propia hoja de estilos del tema aplica este ajuste predefinido, para un ajuste predefinido aplicado por clase en lugar de por variables."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:965
msgid "Which properties this preset genuinely stores itself, as property => true. A bound property absent here is only inherited from the baseline's own definition of the same preset slug, and a control shows it as a muted default rather than as bound."
msgstr "Qué propiedades almacena realmente este ajuste predefinido por sí mismo, como propiedad => true. Una propiedad vinculada que no aparezca aquí solo se hereda de la propia definición de la base del mismo slug de ajuste predefinido, y un control la muestra como un valor predeterminado atenuado en lugar de como vinculada."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:956
msgid "The preset's property => value map: an alias or literal, a per-corner list, or a responsive envelope."
msgstr "El mapa propiedad => valor del ajuste predefinido: un alias o literal, una lista por esquina o una envoltura adaptable."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:952
msgid "The preset's human-readable label."
msgstr "La etiqueta legible por personas del ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:542
msgid "A preset slug is required."
msgstr "Se requiere un slug de ajuste predefinido."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1834
msgid "The palette id to make current."
msgstr "El ID de la paleta que convertir en actual."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1817
msgid "The swatch's structural label. Only valid when {id} is the library's default palette — labels are defined once, not per palette."
msgstr "La etiqueta estructural de la muestra. Solo es válida cuando {id} es la paleta predeterminada de la biblioteca: las etiquetas se definen una vez, no por paleta."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1813
msgid "The swatch value: a literal color or a {dot.path} alias."
msgstr "El valor de la muestra: un color literal o un alias {dot.path}."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1790
msgid "The swatch token dot-path."
msgstr "La ruta con puntos del token de la muestra."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1723
#: includes/resources/Design_Tokens/Rest/V1/Presets_Controller.php:2345
msgid "Optional token library slug to target; defaults to the active library."
msgstr "Slug de biblioteca de tokens de destino opcional; por defecto, la biblioteca activa."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1685
msgid "Sorry, that palette does not exist."
msgstr "Lo siento, esa paleta no existe."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1382
msgid "Accent"
msgstr "Acento"

#. translators: %s: the token dot-path.
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1138
msgid "Swatch \"%s\" is part of the shipped palette and cannot be removed."
msgstr "La muestra «%s» forma parte de la paleta incluida y no se puede eliminar."

#. translators: %s: the alias target.
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1096
msgid "Swatch value aliases a token that does not exist: \"%s\"."
msgstr "El valor de la muestra hace referencia a un token que no existe: «%s»."

#. translators: %s: the token dot-path.
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1085
msgid "Token \"%s\" appears more than once in the palette."
msgstr "El token «%s» aparece más de una vez en la paleta."

#. translators: %s: the token dot-path.
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1078
msgid "Swatch token \"%s\" does not target a color."
msgstr "El token de la muestra «%s» no apunta a un color."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1026
msgid "Each swatch must have a token, a label, and a value."
msgstr "Cada muestra debe tener un token, una etiqueta y un valor."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1017
msgid "Each color group must have an id, a label, and a swatches list."
msgstr "Cada grupo de colores debe tener un ID, una etiqueta y una lista de muestras."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1003
msgid "A palette must define at least one color group."
msgstr "Una paleta debe definir al menos un grupo de colores."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:997
msgid "The palette label must be a string."
msgstr "La etiqueta de la paleta debe ser una cadena."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:972
msgid "The color palette could not be saved."
msgstr "No se pudo guardar la paleta de colores."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:943
msgid "The color palette could not be encoded."
msgstr "No se pudo codificar la paleta de colores."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:916
msgid "The color palette failed validation."
msgstr "La paleta de colores no superó la validación."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:666
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1768
msgid "The ordered color groups, each an ordered list of swatches."
msgstr "Los grupos de colores ordenados, cada uno una lista ordenada de muestras."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:661
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1763
msgid "The palette label."
msgstr "La etiqueta de la paleta."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:656
#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:1741
msgid "The palette id."
msgstr "El ID de la paleta."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:618
msgid "The current palette must name a palette the library defines."
msgstr "La paleta actual debe indicar una paleta que defina la biblioteca."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:496
msgid "A swatch label is structural and can only be set on the library's default palette."
msgstr "Una etiqueta de muestra es estructural y solo se puede establecer en la paleta predeterminada de la biblioteca."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:490
msgid "A swatch label cannot be empty."
msgstr "Una etiqueta de muestra no puede estar vacía."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:486
msgid "A swatch value cannot be empty."
msgstr "Un valor de muestra no puede estar vacío."

#: includes/resources/Design_Tokens/Rest/V1/Palettes_Controller.php:482
msgid "A swatch value or label is required."
msgstr "Se requiere un valor de muestra o una etiqueta."

#: includes/resources/Design_Tokens/Rest/V1/Feed_Controller.php:246
msgid "The token library slug to read the feed for."
msgstr "El slug de la biblioteca de tokens para la que leer el feed."

#: includes/resources/Design_Tokens/Rest/V1/Feed_Controller.php:225
msgid "The REST descriptor (root, namespace, nonce) the app writes edits to."
msgstr "El descriptor de REST (root, namespace, nonce) al que la aplicación envía las ediciones."

#: includes/resources/Design_Tokens/Rest/V1/Feed_Controller.php:218
msgid "Authored responsive / clamp shape keyed by token dot-path id."
msgstr "Forma adaptable o de clamp creada, indexada por el ID de ruta con puntos del token."

#: includes/resources/Design_Tokens/Rest/V1/Feed_Controller.php:211
msgid "The nav-ready block-presets section, for labeled/picker-driven preset bindings only."
msgstr "La sección de ajustes predefinidos de bloques lista para la navegación, solo para vinculaciones de ajustes predefinidos con etiqueta o mediante selector."

#: includes/resources/Design_Tokens/Rest/V1/Feed_Controller.php:204
