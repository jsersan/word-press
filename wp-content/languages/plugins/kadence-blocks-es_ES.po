msgstr "El nuevo ID está reservado por el sistema."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:595
msgid "The new id is already in use."
msgstr "El nuevo ID ya está en uso."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:581
