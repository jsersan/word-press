msgstr "La definición almacenada no tiene $type y no se puede renombrar."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:558
msgid "This primitive has references that cannot be automatically resolved. Remove them manually before renaming."
msgstr "Esta primitiva tiene referencias que no se pueden resolver automáticamente. Elimínalas manualmente antes de renombrarla."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:471
msgid "This primitive has references that cannot be automatically resolved. Remove them manually before deleting."
msgstr "Esta primitiva tiene referencias que no se pueden resolver automáticamente. Elimínalas manualmente antes de borrarla."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:443
msgid "System primitives cannot be deleted."
msgstr "Las primitivas del sistema no se pueden borrar."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:395
msgid "That id is reserved by the system."
msgstr "Ese ID está reservado por el sistema."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:382
msgid "A custom token with that id already exists."
msgstr "Ya existe un token personalizado con ese ID."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:371
msgid "That id is used by a system token."
msgstr "Ese ID lo usa un token del sistema."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:357
msgid "That $type does not support user-created primitives in this version."
msgstr "Ese $type no admite primitivas creadas por el usuario en esta versión."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:346
msgid "That group is not declared for user-created primitives."
msgstr "Ese grupo no está declarado para primitivas creadas por el usuario."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:335
msgid "The group must be a lowercase kebab-case key."
msgstr "El grupo debe ser una clave en kebab-case en minúsculas."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:318
msgid "The id must be a lowercase kebab-case slug with no dots (e.g. my-color)."
msgstr "El ID debe ser un slug en kebab-case en minúsculas y sin puntos (por ejemplo, my-color)."

#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:260
#: includes/resources/Design_Tokens/Rest/V1/User_Primitives_Controller.php:456
